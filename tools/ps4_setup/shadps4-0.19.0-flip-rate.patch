 s32 PS4_SYSV_ABI sceVideoOutSetFlipRate(s32 handle, s32 rate) {
     LOG_TRACE(Lib_VideoOut, "called");
+    // D1_FLIP_RATE=N replaces the rate the title asks for (Destiny asks for 1, a flip every second
+    // vblank, i.e. 30 Hz). 0 flips on every vblank, which a 60 Hz engine-clock patch needs.
+    static const char* forced = std::getenv("D1_FLIP_RATE");
+    if (forced && *forced) {
+        const s32 requested = rate;
+        rate = std::atoi(forced);
+        LOG_INFO(Lib_VideoOut, "D1_FLIP_RATE: title asked for {}, using {}", requested, rate);
+    }
     driver->GetPort(handle)->flip_rate = rate;
     return ORBIS_OK;
 }
