+
+#pragma once
+
+namespace Core::D1NativeMouse {
+
+/// Installs the D1 mouse detours that the environment asks for (D1_MOUSE_PROBE). Call once the
+/// game's patches are applied, before the guest runs.
+void Install();
+
+} // namespace Core::D1NativeMouse
