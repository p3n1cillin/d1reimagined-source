<?xml version="1.0" encoding="utf-8"?>
<!-- Excerpt: the "60 Hz Engine Time Control" entry of the launcher manifest
     apps/launcher/resources/CUSA00219-lab-manifest-T1-60hz-fov105.xml (lines 340-357), verbatim. -->
<Patch>
  <!--
    60 Hz engine time control (clood, 1.0) - experimental. TIME_CONTROL cadence 30 -> 60 Hz.
    Does NOT include the two VideoOut patches. Known to stress the physics host (physics is
    framerate-locked in D1). Addresses are already in the xml convention (vaddr + 0x400000):
    0x9918B3/C7/D1 = vaddr 0x5918B3/C7/D1, unique byte matches against the 01.29 eboot.
  -->
  <Metadata Name="60 Hz Engine Time Control"
            isEnabled="true" AppVer="01.29" Author="clood" PatchVer="1.0">
    <PatchList>
      <!-- 33.3667 ms -> 16.6833 ms -->
      <Line Type="bytes" Address="0x9918B3" Value="c785bcfeffff77778541"/>
      <!-- 30 Hz -> 60 Hz -->
      <Line Type="bytes" Address="0x9918C7" Value="c785c4feffff3c000000"/>
      <!-- 33.3333 ms -> 16.6667 ms -->
      <Line Type="bytes" Address="0x9918D1" Value="c785c8feffff55558541"/>
    </PatchList>
  </Metadata>

</Patch>
