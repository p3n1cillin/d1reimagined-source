# SPDX-License-Identifier: GPL-2.0-or-later
# The served 56578 lab session that every launch profile builds on: the geared Guardian, the Director
# flags, the vendors, the Activity Host following the launched activity. It is the set
# tools/ps4_setup/d1-lab-served.ps1 serves, plus the vendor, idle and sensor-cache knobs
# lab/tower-route/ending-run.ps1 adds. Nothing in this file is a new subsystem: full-game.env turns
# those on and baseline.env turns them off, each on top of this file.
#
# Format (read by tools/ps4_setup/d1-full-game.ps1; tests/test_full_game_profile.py checks it):
#   @include FILE     read FILE (relative to this one) first; later lines win
#   [launch]          launcher settings (not environment variables)
#   [server]          knobs for d1-responder, d1-activity-host and shadnet-server
#   [sidecar]         knobs the activity host passes on to the script sidecar (tools/script-host)
#   [emulator]        knobs for the shadPS4 fork
#   KEY=VALUE         an empty VALUE unsets the knob (it is removed from the environment)
#   ?KEY=VALUE        set only when the target binary has the knob (its name is in the .exe);
#                     otherwise dropped and reported. For code that is not merged or not deployed.
#   ${NAME}           a [launch] value, or REPO ROOT TOOLS WORKSPACE STAGING FIXTURES PROFILES RUN BIN
#   ${env:NAME}       an environment variable (empty when unset)
# Every knob has one comment line above it naming where it comes from.

[launch]
# The world the Activity Host publishes at boot (d1-lab-served.ps1's default).
ACTIVITY=pvp_moonbase
# The client patch (d1-lab-served.ps1's default).
CLIENT_PATCH=${REPO}/ps4/patches/CUSA00219-56578-lab-orbit.xml
# Session length in minutes (the contained boot stops the emulator and servers after it).
MINUTES=240
# The isolated D1 Lab adapter (tools/ps4_setup/d1-lab-net.cmd). The launcher never changes it.
LAB_IP=10.77.0.2
# 1 = the person at the pad drives the client (no title taps), as d1-lab-served.ps1 runs.
OPERATOR_INPUT=1
# Node 22 for the script sidecar (F:\d1\tools\node on the lab PC; `node` on PATH if absent).
NODE=${TOOLS}/node/node.exe
# The local Blam Network tiger checkout (BullShcript, Fukugen Daihon). Local use only, never vendored.
TIGER=${ROOT}/third-party/Blam-Network_tiger

[server]
# d1-lab-served.ps1: answer families 0 and 2.
D1_ANSWER_FAMILIES=0,2
# d1-lab-served.ps1: the geared Guardian's peer roster cards.
D1_ROSTER_DIR=${FIXTURES}/characters/rosters-f0-geared
# d1-lab-served.ps1: the sensor lifetime phase served.
D1_AH_SENSOR_PHASE=3
# d1-lab-served.ps1: re-send the sensor list every 10 s.
D1_AH_SENSOR_REPEAT_S=10
# d1-lab-served.ps1: the boot world's sensor-client list.
D1_AH_SENSOR_CLIENTS=${FIXTURES}/mission/sensor-clients-pvp_moonbase-bundle7-team0.txt
# d1-lab-served.ps1: the responder writes the launched activity here.
D1_ACTIVITY_FOLLOW_FILE=${RUN}/launched-activity.txt
# d1-lab-served.ps1: the host follows the launched activity from the same file.
D1_AH_ACTIVITY_FOLLOW_FILE=${RUN}/launched-activity.txt
# d1-lab-served.ps1: activity index to manifest hash.
D1_AH_ACTIVITY_TABLE=${FIXTURES}/characters/activity-table.tsv
# d1-lab-served.ps1: the served profile (completion flags live here).
D1_PROFILE_FILE=${FIXTURES}/characters/profile-geared-385-director-c.bin
# d1-lab-served.ps1: unlock flags; never 308 or 3391 (the Tower's rule needs both clear).
D1_UNLOCK_FLAGS=98,419,440,834,2668,5021,5998,6029,433,2539,2549,3558,3587
# d1-lab-served.ps1: the geared inventory.
D1_INVENTORY=${FIXTURES}/characters/inventory
# d1-lab-served.ps1: family 4 type 2 key-only object.
D1_FAMILY42=1
# d1-lab-served.ps1: family 4 type 4 unlocks.
D1_UNLOCKS=key
# d1-lab-served.ps1: the Private Match activities served team 0's list. The Towers (0, 1) too: the
# client matchmakes them as a public activity and its team picker puts the player on team 0, so a
# team -1 spawn bundle never spawns them (run rev11, notes/ps4-56578-reveal-tower-2026-11-08.md).
D1_AH_TEAM0_ACTIVITIES=410,416,0,1
# The live A Guardian Rises host served the player bundle unarmed (+8, +9 = 0) until the rifle, then
# armed: script phase 3 (run gh2; live capture, 527 s).
D1_AH_UNARMED_UNTIL_PHASE=164:3
# notes/ps4-56578-cine-live13-2026-11-05.md: the hand world table, with 165 served as the live host served it.
D1_AH_WORLD_TABLE=${FIXTURES}/mission/world-table-cine-live.txt
# ending-run.ps1: the world period at the PS4's 30 Hz.
D1_AH_WORLD_PERIOD_MS=33.333333
# ending-run.ps1: the sense schemas the host decodes (squad counts for the script bridge too).
D1_AH_SENSE_SCHEMAS=1:0x80800357,2:0x808005D9,3:0x80800830,4:0x80800387,0xC:0x80802C30,0x18:0x8080048A,0x1C:0x808005C3,0x27:0x80802B18
# ending-run.ps1: on-demand profile pushes.
D1_PROFILE_PUSH_FILE=${RUN}/profile-push.bin
# ending-run.ps1 / notes/ps4-56578-idle-timer-2026-10-31.md: a day's idle limit.
D1_INACTIVITY_MS=86400000
# ending-run.ps1 (#197): built sensor frames kept between runs.
D1_AH_SENSOR_CACHE=${STAGING}/sensor-cache
# d1-agr-run.ps1: the host's live control file (`clients GROUP PATH`).
D1_AH_CONTROL_FILE=${RUN}/ah-control.txt
# ending-run.ps1: Glimmer, Silver and Legendary Marks in the account.
D1_ACCOUNT_FILE=${FIXTURES}/vendor/account-currencies.bin
# ending-run.ps1: on-demand account pushes.
D1_ACCOUNT_PUSH_FILE=${RUN}/account-push.bin
# ending-run.ps1 / notes/ps4-56578-vendor-purchase-2026-10-30.md: the vendor sale table.
D1_VENDOR_SALES=${FIXTURES}/vendor/vendor-sales.tsv
# ending-run.ps1: the served profile as a decoded object (purchases add items to it).
D1_VENDOR_PROFILE_OBJ=${FIXTURES}/vendor/vendor-profile.obj
# ending-run.ps1: the item template for bought instances.
D1_VENDOR_ITEM_TEMPLATE=${FIXTURES}/vendor/vendor-item-template.obj
# ending-run.ps1: the account slots the account file serves.
D1_VENDOR_ACCOUNT_SLOTS=308:869:25000,309:873:500,310:4548:200
# ending-run.ps1: the d1-oracle the responder encodes with (this run's snapshot).
D1_ORACLE=${BIN}/d1-oracle.exe

[sidecar]
# (nothing in the base: the sidecar only runs with D1_AH_SCRIPTS)

[emulator]
# ending-run.ps1 / notes/ps4-56578-lab-stalls-2026-11-05.md: D1 Video off; the title's 30 Hz unless D1_FPS says.
D1_VIDEO=0
# fork d1 (#6): unset keeps the title's rate; the draw-cost A/B sets 60 or 0 (uncapped).
D1_FPS=
