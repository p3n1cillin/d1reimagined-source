# SPDX-License-Identifier: GPL-2.0-or-later
# The baseline for the full-game test: the same served lab session (lab-base.env) with every knob
# full-game.env turns on turned off, so an A/B differs only in the new subsystems. An empty value
# unsets the knob (the subsystem's own default, off); 0 is used where the fork's default is on.
# tests/test_full_game_profile.py checks that this file covers every knob in full-game.env.
@include lab-base.env

[server]
# #307 player store: off (the fixtures are served as before).
D1_STORE=
# #307 player store: unused with the store off.
D1_STORE_DIR=
# #307 player store: unused with the store off.
D1_STORE_PLAYER=
# #307 player store: no command file.
D1_STORE_CONTROL=
# #307 player store: the build's own table.
D1_PROGRESSION_CURVES=
# #307 player store: the build's own table.
D1_VENDOR_RESETS=
# #307 player store: the build's own table.
D1_REFUND_POLICIES=
# #307 player store: the build's own table.
D1_ACTIVITY_REWARDS=
# #309 social and vendors: off.
D1_SOCIAL=
# #309 social and vendors: stock not enforced.
D1_SOCIAL_STOCK=
# #309 social and vendors: no placeholder yields.
D1_DISMANTLE_PLACEHOLDER=
# #311 rewards: off.
D1_REWARDS=
# #311 rewards: the time seeds rolls.
D1_REWARDS_SEED=
# #312 multiplayer: off (single player).
D1_MP=
# #312 multiplayer: no configurations file.
D1_MM_CONFIG_FILE=
# #312 multiplayer: one client per instance.
D1_AH_SHARED_INSTANCES=
# #313 activity framework: not loaded.
D1_AH_ACTIVITY_FRAMEWORK=
# #314 worlds: hand world tables only.
D1_AH_WORLDS=
# #314 worlds: unused without D1_AH_WORLDS.
D1_AH_WORLDS_ACTIVITIES=
# #314 worlds: unused without D1_AH_WORLDS.
D1_AH_WORLDS_PRIVATE_START=
# #316 public instances: off.
D1_AH_PUBLIC_HOST=
# Public sessions: no ambassadorship (the region records carry only the region and token).
D1_AH_PUBLIC_AMBASSADOR=
# #316 public instances: unused with the public host off.
D1_AH_PUBLIC_TABLE=
# #316 public instances: every connection presents the mission host's id.
D1_AH_DISTINCT_HOST_IDS=
# stream O2: no public-instance snapshot for the matchmaker.
D1_AH_PUBLIC_INSTANCES_FILE=
# #317 native RSAT codec: the client's own codec (d1-oracle) for everything.
D1_RSAT_NATIVE=
# #298 udt 5 stamp mode: stamp 0, as before.
D1_AH_SENSOR_STAMP=
# #319 script bridge: off (the step machine serves every activity).
D1_AH_SCRIPTS=
# #319 script bridge: no sidecar.
D1_AH_SCRIPTS_SIDECAR=
# #319 script bridge: no scripted activities.
D1_AH_SCRIPTS_ACTIVITIES=
# stream K: no slice states (the bridge then takes phase regions from the table only).
D1_AH_SCRIPTS_SLICE_STATES=
# #319 script bridge: default catalogue path.
D1_AH_SCRIPTS_INCIDENTS=
# #319 script bridge: off.
D1_AH_SCRIPTS_MISSION_PHASE=
# #319 script bridge: no column file.
D1_AH_SCRIPTS_SCOREBOARD_COLUMNS=
# #319 script bridge: off.
D1_AH_ROWS_UNLISTED=
# #319 script bridge: off.
D1_AH_ROWS_DELTA_INIT=
# #319 script bridge: no start cushion with the bridge off.
D1_AH_SCRIPTS_START_DELAY=
# #319 script bridge: no arrival cushion with the bridge off.
D1_AH_SCRIPTS_ARRIVAL_CUSHION=
# #319 script bridge: no list retry with the bridge off.
D1_AH_SCRIPTS_LIST_RETRY=
# #319 script bridge: no slice lists with the bridge off.
D1_AH_SCRIPTS_SLICE_LISTS=

[sidecar]
# #310 script sidecar: no scripts.
D1_SCRIPTS_DIR=
# #310 script sidecar: no BullShcript checkout.
D1_TIGER_DIR=
# stream K: no bundle export.
D1_BUNDLES_DIR=

[emulator]
# fork #7 draw cost: no stats.
D1_DRAW_STATS=
# fork #7 draw cost: upstream's draw path.
?D1_DRAW_FAST=0
# fork #7 draw cost: guest waits spin.
D1_GPU_WAIT_YIELD=
# fork #8 PC client: the stubs, as upstream.
?D1_EXCEPTION_HANDLERS=0
# fork #8 PC client: upstream's unhandled-exception path.
?D1_CLEAN_EXIT=0
# fork #8 PC client: no detour; the game halts as on a console.
D1_HITCH_HALT=
# fork #8 PC client: wall-clock audio pacing, as upstream.
D1_AUDIO_SYNC=
# fork #8 PC client: no PC layout.
D1_PC_LAYOUT=
# fork #8 PC client: upstream's disconnect.
D1_PAD_KEEP_KEYBOARD=
# fork d1 (#113 PC controls): no mouse cursor.
D1_MOUSE_CURSOR=
# fork d1 (#113 PC controls): no mouse buttons.
D1_MOUSE_BUTTONS=
# fork d1 (#113 PC controls): no mouse look.
D1_MOUSE_LOOK=
