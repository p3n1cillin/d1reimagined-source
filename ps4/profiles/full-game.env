# SPDX-License-Identifier: GPL-2.0-or-later
# The full-game test: the served lab session (lab-base.env) with every subsystem built on 5 November
# switched on. Launch it with tools/ps4_setup/d1-full-game.ps1 (docs/full-game-test.md); baseline.env
# is the same session with all of these off. The format is described in lab-base.env.
# Each knob's comment names the pull request (source repo #NNN, fork #N) or stream it comes from.
@include lab-base.env

[server]
# #307 player store: persist the account and character between sign-ons.
D1_STORE=1
# #307 player store: a store kept for full-game runs only (delete the folder for a new Guardian).
D1_STORE_DIR=${STAGING}/player-store-full-game
# #307 player store: the identity's player name (the first player keeps the D1_*_SOID knobs).
D1_STORE_PLAYER=local
# #307 player store: the command file the store polls; #313's checkpoints are written to it.
D1_STORE_CONTROL=${RUN}/store-control.txt
# #307 player store: XP and rank curves from this checkout (not the build checkout's).
D1_PROGRESSION_CURVES=${FIXTURES}/progression/progression-curves.tsv
# #307 player store: vendor reset schedules from this checkout.
D1_VENDOR_RESETS=${FIXTURES}/progression/vendor-resets.tsv
# #307 player store: refund policies from this checkout.
D1_REFUND_POLICIES=${FIXTURES}/progression/refund-policies.tsv
# #307 player store: completion rewards from this checkout (stand-in rows are labelled).
D1_ACTIVITY_REWARDS=${FIXTURES}/progression/activity-rewards.tsv
# #309 social and vendors (stream I): the social services' wire hooks.
D1_SOCIAL=1
# The live capture's new Warlock got the even-numbered armour variants; Titan and Hunter by the same pairing.
# #370 character creation: a created Guardian's armour and Ghost as retail granted them.
D1_STARTING_KIT=${FIXTURES}/characters/starting-kit-retail.tsv
# #361 character creation: a created Guardian's completion record is its creation record's five flags.
D1_CREATION_FLAGS=content
# The stock rotation is a random stand-in and the client lists the whole catalogue, so enforcing it
# refuses visible sales (integration review, finding 5; social_hooks.rs).
# #309 social and vendors: each vendor's daily/weekly stock is NOT enforced.
D1_SOCIAL_STOCK=0
# #309 social and vendors: labelled placeholder dismantle yields (no sourced amounts yet).
D1_DISMANTLE_PLACEHOLDER=1
# #311 rewards (stream M): the reward and growth services.
D1_REWARDS=1
# #311 rewards: a fixed seed, so every grant of the run can be replayed.
D1_REWARDS_SEED=0xD1F0
# #312 multiplayer (stream H): identities, fireteams, matchmaking, platform sessions.
D1_MP=1
# #312 multiplayer: the kind-4 matchmaking configurations.
D1_MM_CONFIG_FILE=${FIXTURES}/matchmaking/configurations.json
# #312 multiplayer: several clients in one activity instance.
D1_AH_SHARED_INSTANCES=1
# #313 activity framework (stream J): strikes, raids, arenas and the Crucible as data (a folder = on).
D1_AH_ACTIVITY_FRAMEWORK=${FIXTURES}/activities
# #314 worlds (stream E): generated worlds; hand rows from D1_AH_WORLD_TABLE still win.
D1_AH_WORLDS=${FIXTURES}/worlds
# stream Q worlds: every activity with a world (535 of 653, the client's own activity table; two frame builds per distinct world and start, about 1,000 natively; tests/all_worlds.rs).
D1_AH_WORLDS_ACTIVITIES=all
# #314 worlds: 1 would serve a public start's private stand-in. Off: Restoration starts in its live
# public region 56, and the private stand-in stalled the load (#314; run fg4b, F26).
D1_AH_WORLDS_PRIVATE_START=0
# #316 public instances (stream G): the bubble host, public lists and the open world.
D1_AH_PUBLIC_HOST=1
# Public sessions: every region's ambassadorship to the player, as the live host assigned it. The
# world content marks the public regions, and +0x19 releases a lone ambassador after
# D1_AH_PUBLIC_THRESHOLD_MS (default 10000) to start its public session (#316; runs fg5/fg5b, F29/F30).
D1_AH_PUBLIC_AMBASSADOR=1
# #316 public instances: the public lists by destination and region.
D1_AH_PUBLIC_TABLE=${FIXTURES}/public/public-table.txt
# #316 public instances (needed by D1_AH_PUBLIC_HOST): one host id per connection.
D1_AH_DISTINCT_HOST_IDS=1
# stream O2: the activity host's public instances for the responder's matchmaker (both servers read it).
D1_AH_PUBLIC_INSTANCES_FILE=${RUN}/public-instances.json
# #317 native RSAT codec, stage 1: native encode/decode for every schema it covers.
D1_RSAT_NATIVE=1
# #298 udt 5 stamp mode (issue #295; notes/ps4-56578-udt5-stamp-init-2026-11-05.md): 10 Hz stamp, init, heartbeats.
D1_AH_SENSOR_STAMP=1
# #319 host script bridge (stream A2): mission scripts drive the host.
D1_AH_SCRIPTS=1
# #319 script bridge: the sidecar command (#310's tools/script-host), split on spaces.
D1_AH_SCRIPTS_SIDECAR=${NODE} ${REPO}/tools/script-host/src/sidecar.mjs
# stream K: every story mission, cinematic and quest mission with a world (generated; the older one-row stand-in is ps4/profiles/script-activities.txt).
D1_AH_SCRIPTS_ACTIVITIES=${FIXTURES}/scripts/activities.txt
# stream K: each slice set's scenario state name hash, for the phases' regions.
D1_AH_SCRIPTS_SLICE_STATES=${FIXTURES}/scripts/slice-states.tsv
# #319 script bridge: the 56578 incident catalogue (#306).
D1_AH_SCRIPTS_INCIDENTS=${FIXTURES}/incidents-56578.tsv
# #319 script bridge: the mission-phase tuple in the lifetime is unverified, so it stays off.
D1_AH_SCRIPTS_MISSION_PHASE=
# #319 script bridge: no scoreboard column file yet (other players' rows are not encoded).
D1_AH_SCRIPTS_SCOREBOARD_COLUMNS=
# #319 script bridge: rows the world's list does not name stay held back (off).
D1_AH_ROWS_UNLISTED=
# stream A2, F52 experiment (7 Nov): objects without a device carry one untyped command, as
# the live host's Breach objects did (tripwire beams; stream A2). Inferred across builds; 1 = on.
D1_AH_OBJECT_EMPTY_COMMAND=
# stream A2 (7 Nov): unplaced squads go out explicitly, as the live host's did, not as the
# client's default (which spawns them besides the scripts' placements; stream A2). 1 = on.
D1_AH_SQUAD_UNPLACED_EXPLICIT=
# #319 script bridge, stream A2 (12 Nov): an incoming objective goes out as mode 2, as the live host sent it on build 51539; mode 1 showed NEW MISSION at every change.
# #319 lab run gh51, 12 Nov: banner gone, titles shown.
D1_AH_OBJECTIVE_INCOMING_MODE=2
# #319 script bridge: init only on full lists, as the live hosts sent (off).
D1_AH_ROWS_DELTA_INIT=
# #319 script bridge (runs fg2/fg3b): a STAND-IN cushion, the scripts start 60 s after the first full list (no client 'loaded' signal).
D1_AH_SCRIPTS_START_DELAY=60
# #319 script bridge (run fg2e): a STAND-IN cushion, the script clock holds after a phase's move until arrival plus 20 s.
D1_AH_SCRIPTS_ARRIVAL_CUSHION=20
# #319 script bridge (run fg2f): a STAND-IN, the first full list goes out again every 10 s until the client's first udt 6, and the start cushion counts from it.
D1_AH_SCRIPTS_LIST_RETRY=10
# #319 script bridge (run fg2d): served values for the records a slice set adds, from the step schedule that plays (/6/1 at 26).
D1_AH_SCRIPTS_SLICE_LISTS=${FIXTURES}/mission/cine-reveal-steps.txt
# #319 script bridge: a story mission that starts in a public slice set is served the live mission host's list (Restoration spawns with it: rst8, rst13).
D1_AH_SCRIPTS_PUBLIC_START_LIST=1
# stream A2 script bridge (F42, run agr19): world-loot drops announced when the scripts create their row (the starter rifle).
D1_AH_SCRIPTS_WORLD_LOOT=${FIXTURES}/mission/world-loot.tsv
# #368 script bridge (F52): props with the live host's device command, armed by a player trigger (the Breach's tripwires).
D1_AH_SCRIPTS_DEVICE_RULES=${FIXTURES}/mission/device-rules.tsv
# #319 script bridge (lab): empty = the mission scripts start at phase 0; a lab run sets it with -Set (for example 164:5, never in a profile), and the join serves that phase's region.
D1_AH_SCRIPTS_START_PHASE=
# #319 script bridge: the scoreboard row at the mission completion, so the rewards screen lists the player (empty in gh64; filled in sb2, 56578).
D1_AH_SCRIPTS_SCOREBOARD=1
# #319 script bridge: the activity flag in the player rows and the interactable placement with its filter row (Restoration's first objective: rst11, rst13).
D1_AH_SCRIPTS_INTERACTABLE=1
# #319 script bridge: the players are ready on the client's second, changed sense of its own player row (udt 6), not after the start cushion; the lifetime then goes active once the client has loaded (run rst15). Needs D1_AH_SENSE_SCHEMAS (lab-base).
D1_AH_SCRIPTS_READY_ON_SENSE=1
# #307 player store: keep the client's 701 account data and restore Settings at sign-in (56578, runs set2/set3).
D1_ACCOUNT_USER_DATA=1

[sidecar]
# #310 script sidecar: the restored 56578 mission scripts (Fukugen Daihon; local input, never committed).
D1_SCRIPTS_DIR=${TIGER}/packages/fukugen-daihon/destiny1/v56578_17_04_12_1251_evil
# #310 script sidecar: Restoration runs the restored 41375 scripts, whose mission 1 waits for the Ghost's line as the live capture does (its first objective shows: rst11, rst13); `activity=folder;...`.
D1_SCRIPTS_DIR_FOR=act_cosmo_m0_5_hangar=${TIGER}/packages/fukugen-daihon/destiny1/v41375_14_07_03_1501_live
# #310 script sidecar: the tiger checkout whose built BullShcript (MIT) the sidecar imports.
D1_TIGER_DIR=${TIGER}
# stream K: the private content bundle export (never committed); required with D1_AH_SCRIPTS=1.
D1_BUNDLES_DIR=${env:D1_BUNDLES_DIR}

[emulator]
# fork #7 draw cost: log the draw path's CPU cost once a second (the A/B needs it on both sides).
?D1_DRAW_STATS=1
# fork #7 draw cost: skip repeated binds, memo the pipeline (=0 is upstream's path, the A side).
?D1_DRAW_FAST=1
# fork #7 draw cost: experimental; a long guest GPU wait yields its time slice.
?D1_GPU_WAIT_YIELD=1
# fork #8 PC client: register Destiny's exception handlers (=0 keeps the stubs).
?D1_EXCEPTION_HANDLERS=1
# fork #8 PC client: the game's fatal path ends the process cleanly (=0 is upstream).
?D1_CLEAN_EXIT=1
# fork #8 PC client: 0 = the hitch detector reports and the game carries on (unset halts, as on a console).
?D1_HITCH_HALT=0
# fork #8 PC client: audio paced by the host device.
?D1_AUDIO_SYNC=1
# fork #8 PC client: the PC keyboard-and-mouse layout (includes cursor, buttons and raw mouse look).
?D1_PC_LAYOUT=1
# fork #8 PC client: the keyboard keeps player 1 when the pad is unplugged.
?D1_PAD_KEEP_KEYBOARD=1
# fork d1 (#113 PC controls): the menu cursor follows the mouse (also on without #8's layout).
?D1_MOUSE_CURSOR=1
# fork d1 (#113 PC controls): mouse buttons in menus and play.
?D1_MOUSE_BUTTONS=1
# fork d1 (#113 PC controls; raw input with fork #8): mouse look in gameplay.
?D1_MOUSE_LOOK=1
# fork #14 occlusion (F51): real ZPASS occlusion queries, so lens flares and glare stop at walls.
?D1_OCCLUSION=1
# fork #16 stencil clear mask (F53): a guest stencil clear keeps to the game's write mask, so the sight reticle draws.
?D1_STENCIL_CLEAR_MASK=1
