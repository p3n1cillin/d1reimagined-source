# Editor defaults for this repository: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,rs}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,mjs,js,cjs,ts}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Patches and fixtures are byte-exact.
[{patches/**,ps4/fixtures/**,data/**}]
trim_trailing_whitespace = false
insert_final_newline = false
